{
  "name": "stageplan-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Web Responsivo de Planificación Logística, Dimensionamiento Eléctrico y Distribución Espacial para Eventos en Formato DJ - INACAP",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@stageplan/frontend -- --host 0.0.0.0 --port 5173",
    "dev:frontend": "npm run dev --workspace=@stageplan/frontend -- --host 0.0.0.0 --port 5173",
    "dev:backend": "npm run dev --workspace=@stageplan/backend",
    "test": "npm run test --workspace=@stageplan/shared",
    "test:coverage": "npm run test:coverage --workspace=@stageplan/shared",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

