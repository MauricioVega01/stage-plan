{
  "name": "@stageplan/shared",
  "version": "1.0.0",
  "description": "Módulo compartido de esquemas Zod y motor de cálculo de ingeniería (calc-engine) para STAGE PLAN",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}

