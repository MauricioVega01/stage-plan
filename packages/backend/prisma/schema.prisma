generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique @map("correo")
  passwordHash      String             @map("clave_hash")
  name              String             @map("nombre")
  role              String             @default("ADMIN") @map("rol")
  createdAt         DateTime           @default(now()) @map("fecha_creacion")
  updatedAt         DateTime           @updatedAt @map("fecha_actualizacion")
  venues            Venue[]
  riderCalculations RiderCalculation[]
  sharedLinks       SharedLink[]

  @@map("usuarios")
}

model Venue {
  id                       String             @id @default(uuid())
  ownerId                  String             @map("usuario_id")
  name                     String             @map("nombre")
  widthMeters              Float              @map("ancho_metros")
  depthMeters              Float              @map("largo_metros")
  heightMeters             Float              @map("alto_metros")
  environmentType          String             @map("tipo_entorno") // INDOOR, OUTDOOR_PARCELA, OUTDOOR_OPEN
  electricalDistanceMeters Float              @map("distancia_electrica_metros")
  createdAt                DateTime           @default(now()) @map("fecha_creacion")
  updatedAt                DateTime           @updatedAt @map("fecha_actualizacion")

  owner                    User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  riderCalculations        RiderCalculation[]

  @@map("recintos")
}

model RiderCalculation {
  id                String       @id @default(uuid())
  ownerId           String       @map("usuario_id")
  venueId           String       @map("recinto_id")
  engineVersion     String       @map("version_motor") // e.g. "4.0.0"
  riderInput        Json         @map("entrada_rider")
  paramsUsed        Json         @map("parametros_usados")
  calculatedResults Json         @map("resultados_calculados")
  alertsSnapshot    Json         @map("alertas_snapshot")
  createdAt         DateTime     @default(now()) @map("fecha_creacion")

  owner             User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  venue             Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sharedLinks       SharedLink[]

  @@map("calculos_rider")
}

model SharedLink {
  id                 String           @id @default(uuid())
  ownerId            String           @map("usuario_id")
  riderCalculationId String           @map("calculo_rider_id")
  token              String           @unique
  expiresAt          DateTime         @map("fecha_expiracion")
  isRevoked          Boolean          @default(false) @map("esta_revocado")
  createdAt          DateTime         @default(now()) @map("fecha_creacion")

  owner              User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  riderCalculation   RiderCalculation @relation(fields: [riderCalculationId], references: [id], onDelete: Cascade)

  @@map("enlaces_compartidos")
}
