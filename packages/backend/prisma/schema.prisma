generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  passwordHash     String
  name             String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  venues           Venue[]
  riderCalculations RiderCalculation[]
  sharedLinks      SharedLink[]

  @@map("users")
}

model Venue {
  id                      String             @id @default(uuid())
  ownerId                 String             @map("owner_id")
  name                    String
  widthMeters             Float              @map("width_meters")
  depthMeters             Float              @map("depth_meters")
  heightMeters            Float              @map("height_meters")
  environmentType         String             @map("environment_type") // INDOOR, OUTDOOR_PARCELA, OUTDOOR_OPEN
  electricalDistanceMeters Float             @map("electrical_distance_meters")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  owner                   User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  riderCalculations       RiderCalculation[]

  @@map("venues")
}

model RiderCalculation {
  id             String       @id @default(uuid())
  ownerId        String       @map("owner_id")
  venueId        String       @map("venue_id")
  engineVersion  String       @map("engine_version") // e.g. "3.1.0"
  riderInput     Json         @map("rider_input")
  paramsUsed     Json         @map("params_used")
  calculatedResults Json      @map("calculated_results")
  alertsSnapshot Json         @map("alerts_snapshot")
  createdAt      DateTime     @default(now())

  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  venue          Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sharedLinks    SharedLink[]

  @@map("rider_calculations")
}

model SharedLink {
  id                 String           @id @default(uuid())
  ownerId            String           @map("owner_id")
  riderCalculationId String           @map("rider_calculation_id")
  token              String           @unique
  expiresAt          DateTime         @map("expires_at")
  isRevoked          Boolean          @default(false) @map("is_revoked")
  createdAt          DateTime         @default(now())

  owner              User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  riderCalculation   RiderCalculation @relation(fields: [riderCalculationId], references: [id], onDelete: Cascade)

  @@map("shared_links")
}

